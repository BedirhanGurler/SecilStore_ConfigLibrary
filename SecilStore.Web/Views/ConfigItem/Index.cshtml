@using SecilStore.Common.DTOs
@model List<ConfigurationItemDto>
@{
    ViewData["Title"] = "Config Item Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">🔧 Config Item Listesi</h2>
        <a href="/ConfigItem/Create" class="btn btn-success">
            <i class="bx bx-plus"></i> Yeni Ekle
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-striped table-hover shadow-sm rounded">
            <thead class="table-primary text-center">
                <tr>
                    <th>Ad</th>
                    <th>Tip</th>
                    <th>Değer</th>
                    <th>Uygulama</th>
                    <th>Oluşturulma</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody class="text-center align-middle">
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Type</td>
                        <td>@item.Value</td>
                        <td>@item.ApplicationName</td>
                        <td>@item.CreatedDate?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <form method="post" asp-action="Delete" asp-controller="ConfigItem" onsubmit="return confirm('Bu kaydı pasif yapmak istiyor musunuz?');">
                                <input type="hidden" name="Id" value="@item.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm" data-bs-toggle="tooltip" title="Pasif Yap">
                                    <i class="bx bx-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">Hiç kayıt bulunamadı.</div>
    }
</div>

@section Scripts {
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        function showToast(message, isSuccess = true) {
            const toastHtml = `
            <div class="toast align-items-center text-white bg-${isSuccess ? 'success' : 'danger'} border-0 mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>`;

            const container = document.getElementById("toastContainer");
            container.innerHTML = toastHtml;
            new bootstrap.Toast(container.querySelector(".toast")).show();
        }
    </script>
}
